# ---------------------------------------------------------------------------
# Nota MVP — copy to .env and fill in what you actually have.
# Nothing here is required to run: with an empty file the app runs in
# "scripted" demo mode (deterministic local planner, no network, no cost).
# ---------------------------------------------------------------------------

# Provider switch: scripted | openai | anthropic
LLM_PROVIDER=scripted

# --- OpenAI-compatible endpoint ---------------------------------------------
# Works for OpenAI, DeepSeek, Moonshot (Kimi), Zhipu (GLM), DashScope (Qwen):
# these all expose an OpenAI-compatible /chat/completions with tool calling.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Speech to text ----------------------------------------------------------
# faster_whisper | noop   (noop = text input only)
# Switch to faster_whisper only after `pip install faster-whisper`, otherwise
# audio uploads fail with a clear "STT unavailable" error. Default stays noop
# so that copying this file never breaks a working install.
STT_PROVIDER=noop
WHISPER_MODEL=small

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/nota.db
DATA_DIR=./data
FREE_DAILY_LIMIT=10
