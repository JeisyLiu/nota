# ---------------------------------------------------------------------------
# Nota MVP — copy to .env and fill in what you actually have.
#
#   cp .env.example .env      (Windows: Copy-Item .env.example .env)
#
# Nothing here is required to run: with an empty OPENAI_API_KEY and
# LLM_PROVIDER=scripted the app runs in demo mode (deterministic local planner,
# no network, no cost), which is enough to verify the whole pipeline.
#
# After filling in a real key, run the pre-flight check before starting:
#   python -m scripts.check_llm
# ---------------------------------------------------------------------------

# Provider switch: scripted | openai | anthropic
LLM_PROVIDER=scripted

# --- OpenAI-compatible endpoint ---------------------------------------------
# Works for OpenAI, DeepSeek, Moonshot (Kimi), Zhipu (GLM), DashScope (Qwen):
# these all expose an OpenAI-compatible /chat/completions with tool calling.
#
#   DeepSeek   https://api.deepseek.com/v1                  deepseek-chat
#   OpenAI     https://api.openai.com/v1                    gpt-4o-mini
#   Moonshot   https://api.moonshot.cn/v1                   moonshot-v1-8k
#   Zhipu      https://open.bigmodel.cn/api/paas/v4         glm-4-flash
#   DashScope  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#
# Leave OPENAI_BASE_URL empty to use https://api.openai.com/v1.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Request behaviour -------------------------------------------------------
# Per-call timeout in seconds.
LLM_TIMEOUT_SECONDS=60
# Honour HTTP_PROXY / HTTPS_PROXY. Set to false if a machine-wide proxy turns
# local or direct API calls into 502s.
LLM_TRUST_ENV=true

# --- Speech to text ----------------------------------------------------------
# faster_whisper | noop   (noop = text input only)
# Switch to faster_whisper only after `pip install faster-whisper`, otherwise
# audio uploads fail with a clear "STT unavailable" error. Default stays noop
# so that copying this file never breaks a working install.
STT_PROVIDER=noop
WHISPER_MODEL=small

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/nota.db
DATA_DIR=./data
FREE_DAILY_LIMIT=10
